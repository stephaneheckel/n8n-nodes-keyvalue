{
  "name": "n8n-nodes-keyvalue",
  "version": "0.6.0",
  "description": "n8n node for storing key-value pairs on the filesystem",
  "license": "MIT",
  "homepage": "https://github.com/stephaneheckel/n8n-nodes-keyvalue#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n-node",
    "key-value",
    "filesystem"
  ],
  "author": {
    "name": "Stephane Heckel",
    "email": "stephane.heckel@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephaneheckel/n8n-nodes-keyvalue.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "rm -f dist/package.json dist/tsconfig.tsbuildinfo && n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/KeyValue/KeyValue.node.js",
      "dist/nodes/KeyValueTrigger/KeyValueTrigger.node.js"
    ],
    "strict": false
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@n8n/node-cli": "*",
    "@types/node": "^26.0.0",
    "eslint": "9.39.4",
    "n8n-workflow": "*",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
